# Matugen generated colors for Kitty
# Basic colors
foreground            {{colors.on_surface.default.hex}}
background            {{colors.surface.default.hex}}
selection_foreground  {{colors.on_primary.default.hex}}
selection_background  {{colors.primary.default.hex}}

# Cursor
cursor                {{colors.primary.default.hex}}
cursor_text_color     {{colors.on_primary.default.hex}}

# URL underline color when hovering
url_color             {{colors.tertiary.default.hex}}

# 16 ANSI colors
# Black
color0  {{colors.surface_container.default.hex}}
color8  {{colors.surface_container_highest.default.hex}}

# Red
color1  {{colors.error.default.hex}}
color9  {{colors.error.default.hex}}

# Green
color2  {{colors.tertiary.default.hex}}
color10 {{colors.tertiary_container.default.hex}}

# Yellow
color3  {{colors.secondary.default.hex}}
color11 {{colors.on_secondary_container.default.hex}}

# Blue
color4  {{colors.primary.default.hex}}
color12 {{colors.primary_container.default.hex}}

# Magenta
color5  {{colors.tertiary.default.hex}}
color13 {{colors.on_tertiary_container.default.hex}}

# Cyan
color6  {{colors.secondary_container.default.hex}}
color14 {{colors.on_secondary_container.default.hex}}

# White
color7  {{colors.on_surface.default.hex}}
color15 {{colors.on_surface.default.hex}}
